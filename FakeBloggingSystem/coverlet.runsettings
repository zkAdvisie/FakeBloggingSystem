<?xml version ="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
	<DataCollectors>
	  <DataCollector friendlyName="XPlat Code Coverage">
		<Configuration>
		  <Format>cobertura</Format>
		  <ExcludeByFile>**/Migrations/*.cs, **/obj/*.cs</ExcludeByFile>
		  <Exclude>[FakeBloggingSystem]Microsoft.AspNetCore.OpenApi.Generated.*,[*.Tests]*, [*]System.Runtime.CompilerServices.*</Exclude>
		</Configuration>
	  </DataCollector>
	</DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>